# Frontend environment. On Vercel, set these in Project Settings > Environment Variables.
# Copy this file to `.env` for local development.

# --- Firebase web config (project: homesiem-fb222) ---------------------------
# These are NOT secrets: they ship in the browser bundle. Real protection is in
# Firebase Auth rules and the backend verifying the ID token.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Backend API -------------------------------------------------------------
# Local dev: http://localhost:8000/api/v1
# Production (Vercel): https://YOUR-BACKEND-DOMAIN/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1
